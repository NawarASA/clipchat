{
  "name": "clipchat",
  "version": "1.0.0",
  "private": true,
  "description": "A video editor for everyone: just say what you want.",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env CLIPCHAT_DEV=1 electron .\"",
    "build": "vite build",
    "start": "vite build && electron .",
    "test": "node scripts/pytest.cjs",
    "build:engine": "node scripts/build-engine.cjs",
    "dist": "vite build && node scripts/build-engine.cjs && electron-builder --win",
    "dist:app": "vite build && electron-builder --win"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "productName": "ClipChat",
  "author": "Nawar",
  "build": {
    "appId": "com.clipchat.app",
    "productName": "ClipChat",
    "copyright": "Copyright © 2026 Nawar",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist-engine",
        "to": "engine-bundle"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ClipChat",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "ClipChat",
      "artifactName": "ClipChat-Setup-${version}.exe"
    }
  }
}
